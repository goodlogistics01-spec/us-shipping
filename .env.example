# Public delivery is explicit and fail-closed. Scope these values to Preview
# first; configure Production only after the controlled acceptance test.
# Never commit credentials or prefix them with NEXT_PUBLIC_.
# INQUIRY_DELIVERY_MODE=hubspot-resend
# INQUIRY_ALLOW_REAL_PROVIDER_PREVIEW=true
# INQUIRY_ALLOW_REAL_PROVIDER_PRODUCTION=true
# HUBSPOT_PORTAL_ID=replace-in-vercel-only
# HUBSPOT_FORM_GUID=replace-in-vercel-only
# HUBSPOT_ACCESS_TOKEN=replace-in-vercel-only
# HUBSPOT_DETAILS_FIELD=gdlogi_inquiry_details
# HUBSPOT_SUBMISSION_TIMEOUT_MS=8000
# RESEND_API_KEY=replace-in-vercel-only
# RESEND_FROM_EMAIL=GOOD LOGISTICS Website <website@mail.gdlogi.com>
# INQUIRY_TO_EMAIL=zoe@gdlogi.com
# RESEND_NOTIFICATION_TIMEOUT_MS=5000

# Public Preview and Production require a shared atomic store. Connect an
# Upstash Redis integration through the Vercel Marketplace and set all values
# below in the applicable Vercel environment. Never prefix secrets with NEXT_PUBLIC_.
# INQUIRY_STATE_STORE=upstash-redis
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-in-vercel-only
# INQUIRY_STATE_KEY_SECRET=replace-with-a-random-server-only-secret
# INQUIRY_STATE_NAMESPACE=gdlogi:inquiry

# Local QA may use process memory only when both values are explicit and the
# incoming request host is loopback. Do not copy these settings to deployment.
# INQUIRY_STATE_STORE=memory
# INQUIRY_ALLOW_MEMORY_STATE=true

# Local QA only. The legacy adapter exists solely for the controllable loopback
# mock. All values are required, and the incoming request must also be loopback.
# Do not copy these settings to Preview or Production.
# INQUIRY_DELIVERY_MODE=legacy-formsubmit
# INQUIRY_PROVIDER_MODE=local-mock
# INQUIRY_PROVIDER_ENDPOINT=http://127.0.0.1:3218/mock
# INQUIRY_ALLOW_LOCAL_MOCK=true

# Local requests are blocked from contacting the real provider by default.
# Enable only for an owner-approved, controlled external-provider test.
# INQUIRY_ALLOW_REAL_PROVIDER_LOCAL=true

# Verifying a Resend sending domain requires provider-issued DNS records. Keep
# DNS unchanged until the owner separately approves the exact records. A test
# sender is not evidence that a production sending domain is verified.

# Leave unset until a real container and an applicable consent flow are approved.
# GTM_CONTAINER_ID=GTM-XXXXXXX
