# Production uses the existing FormSubmit endpoint when no provider override is set.
# A remote override must be HTTPS. Do not commit provider credentials or real secrets.
# INQUIRY_PROVIDER_ENDPOINT=https://provider.example/api/inquiry
INQUIRY_PROVIDER_TIMEOUT_MS=28000

# Local QA only. All three values are required, and the incoming site request must
# also use localhost, 127.0.0.1 or ::1. Do not copy these settings to deployment.
# INQUIRY_PROVIDER_MODE=local-mock
# INQUIRY_PROVIDER_ENDPOINT=http://127.0.0.1:3199/mock
# INQUIRY_ALLOW_LOCAL_MOCK=true

# Local requests are blocked from contacting the real provider by default.
# Enable only for an owner-approved, controlled inbox test.
# INQUIRY_ALLOW_REAL_PROVIDER_LOCAL=true

# Leave unset until a real container and an applicable consent flow are approved.
# GTM_CONTAINER_ID=GTM-XXXXXXX
