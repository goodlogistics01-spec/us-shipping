# Production uses the existing FormSubmit endpoint when no provider override is set.
# A remote override must be HTTPS. Do not commit provider credentials or real secrets.
# INQUIRY_PROVIDER_ENDPOINT=https://provider.example/api/inquiry
INQUIRY_PROVIDER_TIMEOUT_MS=18000

# Public Preview and Production require a shared atomic store. Connect an
# Upstash Redis integration through the Vercel Marketplace and set all values
# below in the applicable Vercel environment. Never prefix secrets with NEXT_PUBLIC_.
# INQUIRY_STATE_STORE=upstash-redis
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-in-vercel-only
# INQUIRY_STATE_KEY_SECRET=replace-with-a-random-server-only-secret
# INQUIRY_STATE_NAMESPACE=gdlogi:inquiry

# Local QA may use process memory only when both values are explicit and the
# incoming request host is loopback. Do not copy these settings to deployment.
# INQUIRY_STATE_STORE=memory
# INQUIRY_ALLOW_MEMORY_STATE=true

# Local QA only. All three values are required, and the incoming site request must
# also use localhost, 127.0.0.1 or ::1. Do not copy these settings to deployment.
# INQUIRY_PROVIDER_MODE=local-mock
# INQUIRY_PROVIDER_ENDPOINT=http://127.0.0.1:3218/mock
# INQUIRY_ALLOW_LOCAL_MOCK=true

# Local requests are blocked from contacting the real provider by default.
# Enable only for an owner-approved, controlled inbox test.
# INQUIRY_ALLOW_REAL_PROVIDER_LOCAL=true

# Leave unset until a real container and an applicable consent flow are approved.
# GTM_CONTAINER_ID=GTM-XXXXXXX
